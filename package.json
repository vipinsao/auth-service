{
  "name": "auth-service",
  "version": "1.0.0",
  "description": "Production-shaped authentication service: JWT access tokens, rotating refresh tokens with reuse detection, RBAC.",
  "license": "MIT",
  "author": "Vipin Sao",
  "type": "module",
  "main": "build/server.js",
  "scripts": {
    "dev": "cross-env NODE_ENV=dev nodemon",
    "build": "tsc -p tsconfig.build.json",
    "start": "cross-env NODE_ENV=prod node build/server.js",
    "typeorm": "node --loader ts-node/esm --no-warnings ./node_modules/typeorm/cli.js -d src/config/data-source.ts",
    "typeorm:built": "node ./node_modules/typeorm/cli.js -d build/config/data-source.js",
    "migration:generate": "npm run typeorm -- migration:generate",
    "migration:run": "npm run typeorm -- migration:run",
    "migration:revert": "npm run typeorm -- migration:revert",
    "migration:show": "npm run typeorm -- migration:show",
    "migration:run:built": "npm run typeorm:built -- migration:run",
    "migration:revert:built": "npm run typeorm:built -- migration:revert",
    "typecheck": "tsc --noEmit",
    "test": "cross-env NODE_NO_WARNINGS=1 NODE_OPTIONS=--experimental-vm-modules jest --runInBand",
    "test:watch": "cross-env NODE_NO_WARNINGS=1 NODE_OPTIONS=--experimental-vm-modules jest --watch --runInBand",
    "test:ci": "cross-env NODE_NO_WARNINGS=1 NODE_OPTIONS=--experimental-vm-modules jest --runInBand --ci",
    "keys:generate": "node scripts/generateKeys.js",
    "lint:check": "eslint .",
    "lint:fix": "eslint . --fix",
    "format:check": "prettier . --check",
    "format:fix": "prettier . --write",
    "prepare": "husky"
  },
  "devDependencies": {
    "@eslint/js": "^9.38.0",
    "@jest/globals": "^30.2.0",
    "@types/bcrypt": "^6.0.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.5",
    "@types/express-validator": "^2.20.33",
    "@types/http-errors": "^2.0.5",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^24.10.0",
    "@types/nodemailer": "^8.0.1",
    "@types/supertest": "^6.0.3",
    "@types/swagger-ui-express": "^4.1.8",
    "@types/winston": "^2.4.4",
    "cross-env": "^10.1.0",
    "eslint": "^9.38.0",
    "globals": "^16.4.0",
    "husky": "^9.1.7",
    "jest": "^30.2.0",
    "lint-staged": "^16.2.6",
    "nodemon": "^3.1.10",
    "prettier": "3.6.2",
    "supertest": "^7.1.4",
    "ts-jest": "^29.4.5",
    "ts-node": "^10.9.2",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.2"
  },
  "lint-staged": {
    "*.ts": [
      "npm run format:fix",
      "npm run lint:fix"
    ]
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "express-rate-limit": "^8.6.2",
    "express-validator": "^7.3.0",
    "helmet": "^8.3.0",
    "http-errors": "^2.0.0",
    "jsonwebtoken": "^9.0.2",
    "nodemailer": "^9.0.5",
    "pg": "^8.14.1",
    "reflect-metadata": "^0.2.2",
    "swagger-ui-express": "^5.0.1",
    "tslib": "^2.8.1",
    "typeorm": "^0.3.31",
    "winston": "^3.18.3"
  }
}
