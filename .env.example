# Copy to .env.dev (or .env.test / .env.prod) - the file loaded is .env.$NODE_ENV.
# Real environment variables always win over this file, so Docker Compose and CI
# do not need one. No value in this file is a secret; fill your own in.

# --- Runtime -----------------------------------------------------------------
PORT=                          # HTTP port to listen on (default 5501)
LOG_LEVEL=                     # winston level: error|warn|info|debug (default info)
APP_BASE_URL=                  # Public URL of the FRONTEND, used to build email links

# --- Database (required) -----------------------------------------------------
DB_HOST=                       # PostgreSQL host
DB_PORT=                       # PostgreSQL port, usually 5432
DB_USERNAME=                   # PostgreSQL user
DB_PASSWORD=                   # PostgreSQL password
DB_NAME=                       # Database name

# --- Tokens ------------------------------------------------------------------
REFRESH_TOKEN_SECRET=          # REQUIRED. HS256 secret for refresh tokens; use a long random string
PRIVATE_KEY_PATH=              # RS256 private key for access tokens (default certs/private.pem)
PUBLIC_KEY_PATH=               # RS256 public key used to verify them (default certs/public.pem)
ACCESS_TOKEN_EXPIRY=           # Access token lifetime, e.g. 15m or 1h (default 1h)
REFRESH_TOKEN_EXPIRY_DAYS=     # Refresh token lifetime in days (default 30)

# --- Cookies and CORS --------------------------------------------------------
COOKIE_DOMAIN=                 # Cookie domain; leave empty for a host-only cookie
CORS_ORIGINS=                  # Comma-separated allowlist (default http://localhost:3000)

# --- Abuse protection --------------------------------------------------------
AUTH_RATE_LIMIT_WINDOW_MINUTES= # Rate limit window for /auth endpoints (default 15)
AUTH_RATE_LIMIT_MAX=           # Credential requests per IP per window (default 20)
REFRESH_RATE_LIMIT_MAX=        # /auth/refresh requests per IP per window (default 120)
MAX_FAILED_LOGIN_ATTEMPTS=     # Failed logins before the account locks (default 5)
ACCOUNT_LOCK_MINUTES=          # How long the lock lasts (default 15)
RATE_LIMIT_DISABLED=           # true disables IP rate limiting; defaults to true only under NODE_ENV=test
RATE_LIMIT_STORE=              # memory (default, per-instance) | postgres (shared by every replica)

# --- Email verification and password reset -----------------------------------
REQUIRE_EMAIL_VERIFICATION=    # true blocks login until the address is verified (default false)
VERIFICATION_TOKEN_TTL_MINUTES= # Lifetime of reset/verification tokens (default 60)

# --- Mail --------------------------------------------------------------------
MAIL_TRANSPORT=                # json (default, logs the mail) | ethereal (free preview inbox) | smtp
MAIL_FROM=                     # From header, e.g. "Auth Service <no-reply@example.com>"
SMTP_HOST=                     # Only for MAIL_TRANSPORT=smtp
SMTP_PORT=                     # Only for MAIL_TRANSPORT=smtp (default 587)
SMTP_SECURE=                   # true for implicit TLS on port 465
SMTP_USER=                     # Only for MAIL_TRANSPORT=smtp
SMTP_PASSWORD=                 # Only for MAIL_TRANSPORT=smtp
