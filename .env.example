# Copy to .env.dev (or .env.test / .env.prod) - the file loaded is .env.$NODE_ENV.
# Real environment variables always win over this file, so Docker Compose and CI
# do not need one. No value in this file is a secret; fill your own in.
#
# The database values below are filled in to match `npm run db:local`, so
# `cp .env.example .env.dev` is enough to start. Everything else is optional and
# documented with its default.
#
# nodemon watches only src/ and tests/, so `npm run dev` will NOT pick up an
# edit to this file - restart it.

# --- Runtime -----------------------------------------------------------------
PORT=                          # HTTP port to listen on (default 5501)
LOG_LEVEL=                     # winston level: error|warn|info|debug (default info)
APP_BASE_URL=                  # Public URL of the FRONTEND, used to build email links
ENABLE_API_DOCS=               # Serve Swagger UI at /api-docs. Defaults to on in dev/test,
                               # off everywhere else - it maps the whole attack surface.

# --- Database (required) -----------------------------------------------------
DB_HOST=localhost              # PostgreSQL host
DB_PORT=5432                   # PostgreSQL port; `npm run db:local` uses this too
DB_USERNAME=postgres           # PostgreSQL user
DB_PASSWORD=postgres           # PostgreSQL password
DB_NAME=authservice_dev        # Database name; use authservice_test in .env.test
DB_SSL=                        # true for hosted Postgres (Neon, RDS); verifies the server certificate

# --- Tokens ------------------------------------------------------------------
REFRESH_TOKEN_SECRET=local-only-change-me   # REQUIRED. Refuses to boot outside dev/test
                                            # unless this is >=32 chars and not an example
                                            # value. Generate: openssl rand -base64 48
PRIVATE_KEY_PATH=              # RS256 private key for access tokens (default certs/private.pem)
PUBLIC_KEY_PATH=               # RS256 public key used to verify them (default certs/public.pem)
ACCESS_TOKEN_EXPIRY=           # Access token lifetime, e.g. 15m or 1h (default 1h)
REFRESH_TOKEN_EXPIRY_DAYS=     # Refresh token lifetime in days (default 30)

# --- Cookies and CORS --------------------------------------------------------
COOKIE_DOMAIN=                 # Cookie domain; leave empty for a host-only cookie
CORS_ORIGINS=                  # Comma-separated allowlist (default http://localhost:3000)

# --- Abuse protection --------------------------------------------------------
AUTH_RATE_LIMIT_WINDOW_MINUTES= # Rate limit window for /auth endpoints (default 15)
AUTH_RATE_LIMIT_MAX=           # Credential requests per IP per window (default 20)
REFRESH_RATE_LIMIT_MAX=        # /auth/refresh requests per IP per window (default 120)
MAX_FAILED_LOGIN_ATTEMPTS=     # Failed logins before the account locks (default 5)
ACCOUNT_LOCK_INITIAL_MINUTES=  # First lock after the cap is hit (default 1)
ACCOUNT_LOCK_MINUTES=          # Longest the lock can grow to; it doubles per failure (default 15)
RATE_LIMIT_DISABLED=           # true disables IP rate limiting; defaults to true only under NODE_ENV=test
RATE_LIMIT_STORE=              # memory (default, per-instance) | postgres (shared by every replica)
TRUST_PROXY=                   # false (default). Number of proxies in front of this service,
                               # e.g. 1. Set it ONLY if this port cannot be reached except
                               # through a proxy that overwrites X-Forwarded-For. Reachable
                               # directly (the Compose stack publishes 5501), any caller picks
                               # their own rate-limit bucket. "true" is refused and warned about.

# --- Email verification and password reset -----------------------------------
REQUIRE_EMAIL_VERIFICATION=    # true blocks login until the address is verified (default false)
VERIFICATION_TOKEN_TTL_MINUTES= # Lifetime of reset/verification tokens (default 60)

# --- Observability -----------------------------------------------------------
# These are OpenTelemetry's own variable names, read by the SDK rather than by
# Config, and every one of them is optional. Left empty, the service exports
# traces and metrics to the console: no collector, no account, nothing to pay
# for. Under NODE_ENV=test they default to none instead.
OTEL_SERVICE_NAME=             # Defaults to auth-service
OTEL_TRACES_EXPORTER=          # console (default) | otlp | none
OTEL_METRICS_EXPORTER=         # console (default) | otlp | none
OTEL_EXPORTER_OTLP_ENDPOINT=   # e.g. http://localhost:4318 - setting this switches
                               # both exporters to otlp unless named explicitly
OTEL_METRIC_EXPORT_INTERVAL=   # Milliseconds between metric exports (default 60000)

# --- Mail --------------------------------------------------------------------
MAIL_TRANSPORT=                # json (default, logs the mail) | ethereal (free preview inbox) | smtp
MAIL_FROM=                     # From header, e.g. "Auth Service <no-reply@example.com>"
SMTP_HOST=                     # Only for MAIL_TRANSPORT=smtp
SMTP_PORT=                     # Only for MAIL_TRANSPORT=smtp (default 587)
SMTP_SECURE=                   # true for implicit TLS on port 465
SMTP_USER=                     # Only for MAIL_TRANSPORT=smtp
SMTP_PASSWORD=                 # Only for MAIL_TRANSPORT=smtp
